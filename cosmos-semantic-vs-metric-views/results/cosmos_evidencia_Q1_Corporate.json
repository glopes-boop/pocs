  "sql": {
    "text": "WITH orders_agg AS (\n  SELECT\n    COUNT(\n      DISTINCT CASE\n        WHEN (\n          (\n            orders.status\n          ) IN ('paid', 'refunded')\n        )\n        AND (\n          (\n            orders.ordered_at\n          ) > CAST('2026-10-31' AS DATE) + INTERVAL (-90) DAY\n        )\n        THEN orders.customer_id\n      END\n    ) AS buyers__f0\n  FROM poc.orders AS orders\n  LEFT JOIN poc.customers AS customers\n    ON orders.customer_id = customers.customer_id\n  WHERE\n    customers.carteira = 'Corporate' AND customers.carteira = 'Corporate'\n)\nSELECT\n  orders_agg.buyers__f0 AS active_customers\nFROM orders_agg",
